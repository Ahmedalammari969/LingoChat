# ============================================================
# LinguaChat Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real values to source control.
# ============================================================

# --- API Base URL ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- WebSocket Base URL ---
VITE_WS_BASE_URL=ws://localhost:8000/ws

# --- App Config ---
VITE_APP_NAME=LinguaChat
VITE_APP_VERSION=1.0.0
