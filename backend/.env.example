# ============================================================
# LinguaChat Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real values to source control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_VERSION=1.0.0

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=

# --- JWT Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Redis (Optional Translation Cache) ---
# Leave empty to use in-memory cache instead (default for development).
# Set to enable Redis-backed cache: redis://localhost:6379
REDIS_URL=

# --- Translation: LibreTranslate (Primary Provider) ---
LIBRETRANSLATE_URL=
# API key is optional depending on your LibreTranslate instance
LIBRETRANSLATE_API_KEY=

# --- Translation: Google Cloud (Optional Fallback) ---
# Leave empty to disable Google fallback. Application works without this.
# When set, Google is used if LibreTranslate fails.
GOOGLE_TRANSLATE_API_KEY=

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# --- Password Hashing ---
BCRYPT_ROUNDS=12

# --- WebSocket ---
WS_HEARTBEAT_TIMEOUT_SECONDS=90
