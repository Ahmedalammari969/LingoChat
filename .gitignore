# ============================================================
# LinguaChat — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
MANIFEST

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# ── Environment Variables (NEVER COMMIT) ────────────────────
.env
.env.local
.env.production
.env.*.local
# .env.example is allowed — it has no real secrets

# ── pytest / Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# ── mypy / type checkers ─────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ── Alembic ──────────────────────────────────────────────────
# Keep migrations but ignore auto-generated pycache inside
backend/migrations/__pycache__/

# ── Node.js / Frontend ───────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# Build output
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Vite cache
frontend/.vite/

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ───────────────────────────────────────────────────
# Do not ignore docker-compose.yml — it is tracked
# Ignore any local overrides
docker-compose.override.yml
docker-compose.local.yml

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
*.pid

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Secrets (extra safety net) ───────────────────────────────
*.pem
*.key
*.cert
*.p12
secrets/

# PDF files - excluded from repository
*.pdf
